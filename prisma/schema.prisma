// Prisma Schema · Mentor Platform
// Dịch trực tiếp từ tài liệu Database Schema đã chốt.
// PostgreSQL + Prisma. Mỗi model đều giữ đúng luật nghiệp vụ.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum SeasonStatus {
  draft
  open_registration
  active
  closed
}

enum UserRole {
  admin
  dpv
  mentor
  mentee
}
enum ValueType {
  number
  text
  boolean
}

enum MentorApplicationStatus {
  draft
  submitted
  interview_scheduled
  interview_awaiting_review
  approved
  rejected
  in_pool
}

enum ProgramStatus {
  active
  withdrawn
  removed
}

enum MenteeApplicationStatus {
  draft
  submitted
  interview_scheduled
  interview_awaiting_review
  approved
  rejected
  in_pool
}

enum AvailabilityStatus {
  waiting
  matched
  seeking_rematch
  paused
  completed
  withdrawn
}

enum NeedCategory {
  learning
  career
  personal_dev
  life_transition
}

enum InterviewPurpose {
  screening
  pause_review
}

enum ApplicantRole {
  mentor
  mentee
}

enum InterviewStatus {
  pending_schedule
  scheduled
  awaiting_review
  passed
  rejected
}

enum ValueRating {
  met
  needs_improvement
}

enum MatchStatus {
  recommended
  pending_coordinator_review
  proposed_to_parties
  mentor_accepted
  mutual_accepted
  first_connection_done
  active
  paused
  ended
}

enum EndReason {
  completed_9_months
  mentor_removed
  pause_unresolved
  mentee_withdrew
  mentor_withdrew
  other
}

enum ReviewDecision {
  pending
  approved
  needs_more_info
}

enum AssignmentStatus {
  pending
  completed_on_time
  overdue_reassigned
}

enum KpiEventType {
  sla_breach
  completed_on_time
  reassignment_received
}

enum PauseRequestStatus {
  pending_review
  resolved_continue
  resolved_ended
}

enum LogVisibility {
  shared
  private
  coordinator_signal
}

enum Mood {
  good
  neutral
  uneasy
  support_needed
}

enum SupportStatus {
  open
  in_progress
  resolved
}

// ============================================================
// Người dùng & Mùa hoạt động
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  email        String   @unique
  phone        String?
  clerkUserId  String?  @unique @map("clerk_user_id")
  authProvider String   @map("auth_provider") @default("clerk")
  role         UserRole @default(mentee)
  createdAt    DateTime @default(now()) @map("created_at")

  // Quan hệ
  mentorApplications    MentorApplication[]
  menteeApplications    MenteeApplication[]
  coordinatorAssignments CoordinatorAssignment[]
  interviewsAsApplicant Interview[]  @relation("Applicant")
  interviewsAsInterviewer Interview[] @relation("Interviewer")
  kpiEvents             CoordinatorKpiEvent[] @relation("CoordinatorKPI")
  pauseRequests         PauseRequest[]
  pauseResolvedBy       PauseRequest[] @relation("PauseResolvedBy")
  endedMatches          Match[]        @relation("EndedMatches")
  mentoringLogs         MentoringLog[]
  monthlyReflections    MonthlyReflection[]
  supportRequests       SupportRequest[] @relation("Requester")
  supportResolved       SupportRequest[] @relation("AssignedCoordinator")
  consents              Consent[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  trainingProgress      TrainingProgress[]
  messages              Message[]
  meetingEvents         MeetingEvent[]
  journeyEntries        JourneyEntry[]

  @@map("users")
}

model Season {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    SeasonStatus @default(draft)
  createdAt DateTime     @default(now()) @map("created_at")

  mentorApplications MentorApplication[]
  menteeApplications MenteeApplication[]
  criteria           SeasonCriteria[]
  coreValues         CoreValue[]
  matches            Match[]
  consents           Consent[]
  trainingModules    TrainingModule[]

  @@map("seasons")
}

model SeasonCriteria {
  id          String    @id @default(uuid()) @db.Uuid
  seasonId    String    @map("season_id") @db.Uuid
  season      Season    @relation(fields: [seasonId], references: [id])
  key         String
  value       String
  valueType   ValueType @map("value_type")
  description String?

  @@unique([seasonId, key])
  @@map("season_criteria")
}

model CoreValue {
  id          String  @id @default(uuid()) @db.Uuid
  seasonId    String  @map("season_id") @db.Uuid
  season      Season  @relation(fields: [seasonId], references: [id])
  code        String
  title       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)

  ratings InterviewValueRating[]

  @@map("core_values")
}

// ============================================================
// Đơn đăng ký Mentor / Mentee
// ============================================================

model MentorApplication {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  user           User                    @relation(fields: [userId], references: [id])
  seasonId       String                  @map("season_id") @db.Uuid
  season         Season                  @relation(fields: [seasonId], references: [id])
  status         MentorApplicationStatus @default(draft)
  programStatus  ProgramStatus           @default(active) @map("program_status")

  identityJson     Json?  @map("identity_json")
  professionalJson Json?  @map("professional_json")
  readinessJson    Json?  @map("readiness_json")
  docsJson         Json?  @map("docs_json")

  // industry: field cần lọc khi ghép cặp → tách cột riêng
  industry String?

  capacityMax  Int   @default(0) @map("capacity_max")
  capacityUsed Int   @default(0) @map("capacity_used")

  commitText       String? @map("commit_text")
  commitmentsJson  Json?   @map("commitments_json")

  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  interviews Interview[]
  matches    Match[]

  @@map("mentor_applications")
}

model MenteeApplication {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  user               User                     @relation(fields: [userId], references: [id])
  seasonId           String                   @map("season_id") @db.Uuid
  season             Season                   @relation(fields: [seasonId], references: [id])
  status             MenteeApplicationStatus  @default(draft)
  availabilityStatus AvailabilityStatus       @default(waiting) @map("availability_status")

  identityJson Json?  @map("identity_json")
  profileJson  Json?  @map("profile_json")
  goalText     String? @map("goal_text")

  consentedAt DateTime? @map("consented_at")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  needs      MenteeNeed[]
  interviews Interview[]
  matches    Match[]

  @@map("mentee_applications")
}

model MenteeNeed {
  id                   String              @id @default(uuid()) @db.Uuid
  menteeApplicationId  String              @map("mentee_application_id") @db.Uuid
  menteeApplication    MenteeApplication   @relation(fields: [menteeApplicationId], references: [id])
  needCategory         NeedCategory        @map("need_category")

  @@index([menteeApplicationId])
  @@index([needCategory])
  @@map("mentee_needs")
}

// ============================================================
// Phỏng vấn (dùng chung 2 mục đích)
// ============================================================

model Interview {
  id                     String           @id @default(uuid()) @db.Uuid
  purpose                InterviewPurpose
  applicantUserId        String           @map("applicant_user_id") @db.Uuid
  applicant              User             @relation("Applicant", fields: [applicantUserId], references: [id])
  applicantRole          ApplicantRole    @map("applicant_role")

  mentorApplicationId  String? @map("mentor_application_id") @db.Uuid
  mentorApplication    MentorApplication? @relation(fields: [mentorApplicationId], references: [id])
  menteeApplicationId  String? @map("mentee_application_id") @db.Uuid
  menteeApplication    MenteeApplication? @relation(fields: [menteeApplicationId], references: [id])

  relatedMatchId String? @map("related_match_id") @db.Uuid
  relatedMatch   Match?  @relation("PauseInterviews", fields: [relatedMatchId], references: [id])

  interviewerId String @map("interviewer_id") @db.Uuid
  interviewer   User   @relation("Interviewer", fields: [interviewerId], references: [id])

  slotAt    DateTime?       @map("slot_at")
  status    InterviewStatus @default(pending_schedule)
  notes     String?
  decidedAt DateTime?       @map("decided_at")
  createdAt DateTime        @default(now()) @map("created_at")

  valueRatings  InterviewValueRating[]
  pauseRequests PauseRequest[]

  @@index([applicantUserId])
  @@index([status])
  @@map("interviews")
}

model InterviewValueRating {
  id          String     @id @default(uuid()) @db.Uuid
  interviewId String     @map("interview_id") @db.Uuid
  interview   Interview  @relation(fields: [interviewId], references: [id])
  coreValueId String     @map("core_value_id") @db.Uuid
  coreValue   CoreValue  @relation(fields: [coreValueId], references: [id])
  rating      ValueRating

  @@unique([interviewId, coreValueId])
  @@map("interview_value_ratings")
}

// ============================================================
// Ghép cặp
// ============================================================

model Match {
  id                 String      @id @default(uuid()) @db.Uuid
  seasonId           String      @map("season_id") @db.Uuid
  season             Season      @relation(fields: [seasonId], references: [id])
  mentorApplicationId String     @map("mentor_application_id") @db.Uuid
  mentorApplication  MentorApplication @relation(fields: [mentorApplicationId], references: [id])
  menteeApplicationId String     @map("mentee_application_id") @db.Uuid
  menteeApplication  MenteeApplication @relation(fields: [menteeApplicationId], references: [id])

  fitScore   Float?      @map("fit_score")
  status     MatchStatus @default(recommended)

  proposedAt          DateTime? @map("proposed_at")
  mentorRespondedAt   DateTime? @map("mentor_responded_at")
  menteeRespondedAt   DateTime? @map("mentee_responded_at")
  firstConnectionAt   DateTime? @map("first_connection_at")
  agreementConfirmedAt DateTime? @map("agreement_confirmed_at")
  endedAt             DateTime? @map("ended_at")

  endReason          EndReason? @map("end_reason")
  endedByCoordinatorId String?   @map("ended_by_coordinator_id") @db.Uuid
  endedByCoordinator User?      @relation("EndedMatches", fields: [endedByCoordinatorId], references: [id])
  endNotes           String?    @map("end_notes")

  createdAt DateTime @default(now()) @map("created_at")

  reviews            MatchReview[]
  pauseRequests      PauseRequest[]
  pauseInterviews    Interview[] @relation("PauseInterviews")
  mentoringLogs      MentoringLog[]
  monthlyReflections MonthlyReflection[]
  supportRequests    SupportRequest[]
  messages           Message[]
  meetingEvents      MeetingEvent[]
  journeyEntries     JourneyEntry[]

  @@index([seasonId, status])
  @@index([mentorApplicationId])
  @@index([menteeApplicationId])
  @@map("matches")
}

// ============================================================
// ĐPV duyệt cặp · SLA & KPI
// ============================================================

model MatchReview {
  id          String         @id @default(uuid()) @db.Uuid
  matchId     String         @map("match_id") @db.Uuid
  match       Match          @relation(fields: [matchId], references: [id])
  decision    ReviewDecision @default(pending)
  decidedAt   DateTime?      @map("decided_at")
  decisionNotes String?      @map("decision_notes")
  createdAt   DateTime       @default(now()) @map("created_at")

  assignments CoordinatorAssignment[]

  @@map("match_reviews")
}

model CoordinatorAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  matchReviewId String           @map("match_review_id") @db.Uuid
  matchReview   MatchReview      @relation(fields: [matchReviewId], references: [id])
  coordinatorId String           @map("coordinator_id") @db.Uuid
  coordinator   User             @relation(fields: [coordinatorId], references: [id])

  assignedAt  DateTime         @default(now()) @map("assigned_at")
  dueAt       DateTime         @map("due_at")
  completedAt DateTime?        @map("completed_at")
  status      AssignmentStatus @default(pending)

  reassignedFromAssignmentId String?                  @map("reassigned_from_assignment_id") @db.Uuid
  reassignedFrom             CoordinatorAssignment?  @relation("Reassignment", fields: [reassignedFromAssignmentId], references: [id])
  reassignedTo               CoordinatorAssignment[] @relation("Reassignment")

  kpiEvents CoordinatorKpiEvent[]

  @@index([status, dueAt])
  @@map("coordinator_assignments")
}

model CoordinatorKpiEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  coordinatorId String                 @map("coordinator_id") @db.Uuid
  coordinator   User                   @relation("CoordinatorKPI", fields: [coordinatorId], references: [id])
  assignmentId  String                 @map("assignment_id") @db.Uuid
  assignment    CoordinatorAssignment  @relation(fields: [assignmentId], references: [id])
  eventType     KpiEventType           @map("event_type")
  occurredAt    DateTime               @default(now()) @map("occurred_at")

  @@index([coordinatorId])
  @@map("coordinator_kpi_events")
}

// ============================================================
// Tạm dừng
// ============================================================

model PauseRequest {
  id            String            @id @default(uuid()) @db.Uuid
  matchId       String            @map("match_id") @db.Uuid
  match         Match             @relation(fields: [matchId], references: [id])
  requestedByUserId String        @map("requested_by_user_id") @db.Uuid
  requestedBy   User              @relation(fields: [requestedByUserId], references: [id])
  requestedByRole ApplicantRole   @map("requested_by_role")

  reasonText  String?  @map("reason_text")
  requestedAt DateTime @default(now()) @map("requested_at")
  status      PauseRequestStatus @default(pending_review)

  interviewId String?   @map("interview_id") @db.Uuid
  interview   Interview? @relation(fields: [interviewId], references: [id])

  resolvedByCoordinatorId String?  @map("resolved_by_coordinator_id") @db.Uuid
  resolvedByCoordinator   User?    @relation("PauseResolvedBy", fields: [resolvedByCoordinatorId], references: [id])
  resolvedAt              DateTime? @map("resolved_at")

  @@map("pause_requests")
}

// ============================================================
// Không gian đồng hành
// ============================================================

model MentoringLog {
  id            String       @id @default(uuid()) @db.Uuid
  matchId       String       @map("match_id") @db.Uuid
  match         Match        @relation(fields: [matchId], references: [id])
  authorUserId  String       @map("author_user_id") @db.Uuid
  author        User         @relation(fields: [authorUserId], references: [id])
  visibility    LogVisibility @default(shared)
  content       String
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("mentoring_logs")
}

model MonthlyReflection {
  id               String   @id @default(uuid()) @db.Uuid
  matchId          String   @map("match_id") @db.Uuid
  match            Match    @relation(fields: [matchId], references: [id])
  respondentUserId String   @map("respondent_user_id") @db.Uuid
  respondent       User     @relation(fields: [respondentUserId], references: [id])
  monthNumber      Int      @map("month_number")
  mood             Mood
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([matchId, monthNumber])
  @@map("monthly_reflections")
}

model SupportRequest {
  id                   String        @id @default(uuid()) @db.Uuid
  matchId              String        @map("match_id") @db.Uuid
  match                Match         @relation(fields: [matchId], references: [id])
  requestedByUserId    String        @map("requested_by_user_id") @db.Uuid
  requestedBy          User          @relation("Requester", fields: [requestedByUserId], references: [id])
  message              String
  status               SupportStatus @default(open)
  assignedCoordinatorId String?      @map("assigned_coordinator_id") @db.Uuid
  assignedCoordinator   User?        @relation("AssignedCoordinator", fields: [assignedCoordinatorId], references: [id])
  createdAt            DateTime      @default(now()) @map("created_at")
  resolvedAt           DateTime?     @map("resolved_at")

  @@map("support_requests")
}

// ============================================================
// Đồng thuận, Thông báo, Audit
// ============================================================

model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  seasonId    String?  @map("season_id") @db.Uuid
  season      Season?  @relation(fields: [seasonId], references: [id])
  consentType String   @map("consent_type")
  version     String?
  acceptedAt  DateTime @default(now()) @map("accepted_at")

  @@map("consents")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model TrainingModule {
  id          String  @id @default(uuid()) @db.Uuid
  seasonId    String  @map("season_id") @db.Uuid
  season      Season  @relation(fields: [seasonId], references: [id])
  audience    String  @default("all") // "all" | "mentor" | "mentee"
  title       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  required    Boolean @default(true)

  progress TrainingProgress[]

  @@index([seasonId, audience])
  @@map("training_modules")
}

model TrainingProgress {
  id       String        @id @default(uuid()) @db.Uuid
  moduleId String        @map("module_id") @db.Uuid
  module   TrainingModule @relation(fields: [moduleId], references: [id])
  userId   String        @map("user_id") @db.Uuid
  user     User          @relation(fields: [userId], references: [id])
  completedAt DateTime    @default(now()) @map("completed_at")

  @@unique([moduleId, userId])
  @@map("training_progress")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  match     Match    @relation(fields: [matchId], references: [id])
  senderUserId String @map("sender_user_id") @db.Uuid
  sender    User     @relation(fields: [senderUserId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([matchId, createdAt])
  @@map("messages")
}

model MeetingEvent {
  id        String    @id @default(uuid()) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  match     Match     @relation(fields: [matchId], references: [id])
  title     String
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  location  String?
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy User     @relation(fields: [createdByUserId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([matchId, startsAt])
  @@map("meeting_events")
}

enum JourneyCategory {
  met
  explored
  realized
  changed
  tried
  next
}

model JourneyEntry {
  id        String          @id @default(uuid()) @db.Uuid
  matchId   String          @map("match_id") @db.Uuid
  match     Match           @relation(fields: [matchId], references: [id])
  authorUserId String        @map("author_user_id") @db.Uuid
  author    User            @relation(fields: [authorUserId], references: [id])
  category  JourneyCategory
  content   String
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([matchId, category])
  @@map("journey_entries")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actor         User?    @relation(fields: [actorUserId], references: [id])
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}
